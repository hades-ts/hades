{
    "name": "generator-hades-bot",
    "version": "0.0.7",
    "description": "Yeoman generator for Hades Discord bots",
    "files": [
        "generators"
    ],
    "keywords": [
        "yeoman-generator"
    ],
    "scripts": {
        "build": "tsc -b",
        "copydeps": "copyfiles --up 1 'src/*/templates/**' generators",
        "lint": "biome lint .",
        "clean": "rimraf -rf ./generators/index.js"
    },
    "dependencies": {
        "chalk": "^4.1.2",
        "yeoman-generator": "~7.5.1",
        "yo": "5.1.0",
        "yosay": "^2.0.2"
    },
    "devDependencies": {
        "@types/node": "^24.0.4",
        "@types/yeoman-generator": "~6.0.0",
        "@types/yosay": "^2.0.3",
        "biome": "catalog:",
        "copyfiles": "^2.4.1",
        "mem-fs": "^4.1.2",
        "onchange": "^7.1.0",
        "rimraf": "^6.0.1",
        "turbo": "catalog:",
        "typescript": "catalog:",
        "yeoman-assert": "^3.1.1"
    },
    "module": "dist/index.mjs"
}
